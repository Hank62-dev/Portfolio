# Realtime server URL used by the SpaceHank browser client.
VITE_SPACEHANK_WS_URL=ws://localhost:8787
VITE_SPACEHANK_API_URL=http://localhost:8787

# Optional worker commands. Leave empty to use the safe demo worker.
# The command receives the task prompt through stdin.
SPACEHANK_CODEX_CMD=
SPACEHANK_CLAUDE_CMD=
SPACEHANK_WORKDIR=.
SPACEHANK_PASSWORD=change-this-before-deploy
SPACEHANK_ORIGIN=http://localhost:5173
