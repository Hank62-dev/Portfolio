# Realtime server URL used by the SpaceHank browser client.
VITE_SPACEHANK_WS_URL=ws://localhost:8787
VITE_SPACEHANK_API_URL=http://localhost:8787
VITE_HANK_RAG_API_URL=http://localhost:8000

# Every worker command is required before that worker can receive a task.
# Each command must read the task prompt from stdin and exit 0 on success.
SPACEHANK_CODEX_CMD=codex exec --full-auto
SPACEHANK_CLAUDE_CMD=claude -p
SPACEHANK_NOVA_CMD=
SPACEHANK_PIXEL_CMD=
SPACEHANK_ATLAS_CMD=
SPACEHANK_RHEA_CMD=
SPACEHANK_GEMINI_CMD=
SPACEHANK_GROK_CMD=
SPACEHANK_DEEPSEEK_CMD=
SPACEHANK_QWEN_CMD=
SPACEHANK_MIRA_CMD=
SPACEHANK_WORKDIR=.
SPACEHANK_PASSWORD=replace-with-a-long-random-secret

# Optional owner helpers on the realtime server; each one is simply off when its variable is empty.
# GEMINI_API_KEY=       Hank DJ and the morning note
# HF_TOKEN=             Image Studio (Hugging Face, free read token)
# CALENDAR_ICS_URL=     today's calendar (a secret iCal address; keep it server-side)
# AI_DAILY_LIMIT=60
# DATABASE_URL=        keeps your personal data in step across devices (a Postgres address, e.g. from Neon). Off when empty.
# SPACEHANK_SYNC_PGLITE=  local development only: an in-process Postgres kept in this folder (or "memory"), so no database has to be installed.
# DISCORD_WEBHOOK_URL=  Creator Lab: post to your own Discord server (a webhook address; keep it secret).
# DISCORD_WEBHOOKS=     optional, several channels as JSON: {"dev-log":"https://discord.com/api/webhooks/..."}
# SPACEHANK_SESSION_SECRET=  optional, signs sign-in tokens with a key other than the password
# The exact origin of the page (scheme + host, no trailing slash). The login and the online sea battle both check it.
# On Render set it to the Vercel production URL, e.g. https://hank62dev.vercel.app
SPACEHANK_ORIGIN=http://localhost:5173
