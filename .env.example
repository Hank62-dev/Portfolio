# Realtime server URL used by the SpaceHank browser client.
VITE_SPACEHANK_WS_URL=ws://localhost:8787
VITE_SPACEHANK_API_URL=http://localhost:8787
VITE_HANK_RAG_API_URL=http://localhost:8000

# Every worker command is required before that worker can receive a task.
# Each command must read the task prompt from stdin and exit 0 on success.
SPACEHANK_CODEX_CMD=codex exec --full-auto
SPACEHANK_CLAUDE_CMD=claude -p
SPACEHANK_NOVA_CMD=
SPACEHANK_PIXEL_CMD=
SPACEHANK_ATLAS_CMD=
SPACEHANK_RHEA_CMD=
SPACEHANK_GEMINI_CMD=
SPACEHANK_GROK_CMD=
SPACEHANK_DEEPSEEK_CMD=
SPACEHANK_QWEN_CMD=
SPACEHANK_MIRA_CMD=
SPACEHANK_WORKDIR=.
SPACEHANK_PASSWORD=replace-with-a-long-random-secret
SPACEHANK_ORIGIN=http://localhost:5173
